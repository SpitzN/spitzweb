# Copy to .env.local and fill in. Values never go in git (docs/setup.md).

# Neon. Locally, use the `development` branch, never `production` (ADR 0009).
# On Vercel, the Neon integration sets both, per preview branch.
# Pooled connection string:
DATABASE_URL=
# Direct connection string, for migrations:
DATABASE_URL_UNPOOLED=

# GitHub OAuth app for admin sign-in (ADR 0005).
# Locally, the "spitzweb (local)" app; on Vercel, the "spitzweb" app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Better Auth signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
