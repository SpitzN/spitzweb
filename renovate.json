{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 6am on thursday"],
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "typescript-eslint supports TypeScript below 6.1 only; see docs/tooling.md.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    },
    {
      "description": "Node types follow the runtime in .nvmrc; bump both together.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<27"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on thursday"]
  }
}
